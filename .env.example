# ==========================================
# Deethavorn Accounting - Environment Config
# ==========================================

# การเชื่อมต่อ MySQL Database บน Hosting ของคุณ
# รูปแบบ: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL="mysql://root:root@localhost:3306/wealthi1_deethavorn"

# การตั้งค่า SMTP ส่งอีเมลแจ้งเตือน (ใช้ Mail Server บน Plesk)
SMTP_HOST="deethavorn.com"
SMTP_PORT=465
SMTP_USER="no-reply@deethavorn.com"
SMTP_PASS="your_email_password"
# อีเมลผู้รับแจ้งเตือนเมื่อมีลูกค้าติดต่อเข้ามา (ค่าเริ่มต้น: dtv_accounting@hotmail.com, c.pimmphisa@gmail.com)
NOTIFICATION_RECEIVER_EMAIL="dtv_accounting@hotmail.com, c.pimmphisa@gmail.com"

# LINE Notify Token สำหรับยิงแจ้งเตือนเข้ากลุ่ม LINE เมื่อมีลูกค้าทักมา (ทางเลือก)
LINE_NOTIFY_TOKEN=""

# พอร์ตสำหรับรัน Next.js (ค่าเริ่มต้น 3000)
PORT=3000

# คีย์สำหรับเข้ารหัส JWT Admin Session (ตั้งเป็นข้อความสุ่มที่ปลอดภัย)
JWT_SECRET="replace_with_a_secure_random_string"

# บัญชีผู้ดูแลเริ่มต้น ใช้เฉพาะตอน seed และไม่ควร commit ค่าจริง
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
RESET_ADMIN_PASSWORD="false"
