# ==========================================
# Deethavorn Accounting - Environment Config
# ==========================================

# การเชื่อมต่อ MySQL Database บน Hosting ของคุณ
# รูปแบบ: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL="mysql://root:root@localhost:3306/wealthi1_deethavorn"

# การตั้งค่า SMTP ส่งอีเมลแจ้งเตือน (ใช้ Mail Server บน Plesk)
SMTP_HOST="deethavorn.com"
SMTP_PORT=465
SMTP_USER="no-reply@deethavorn.com"
SMTP_PASS="your_email_password"
# อีเมลผู้รับแจ้งเตือนเมื่อมีลูกค้าติดต่อเข้ามา (ค่าเริ่มต้น: dtv_accounting@hotmail.com, c.pimmphisa@gmail.com)
NOTIFICATION_RECEIVER_EMAIL="dtv_accounting@hotmail.com, c.pimmphisa@gmail.com"

# LINE Notify Token สำหรับยิงแจ้งเตือนเข้ากลุ่ม LINE เมื่อมีลูกค้าทักมา (ทางเลือก)
LINE_NOTIFY_TOKEN=""

# โซนเวลาประเทศไทย (สำหรับเซิร์ฟเวอร์ Cloud/Plesk ที่เป็น UTC)
TZ="Asia/Bangkok"

# พอร์ตสำหรับรัน Next.js (ค่าเริ่มต้น 3000)
PORT=3000

# Canonical Site URL (แนะนำ: https://www.deethavorn.com มี www เพื่อให้ตรงกับ Production Redirect)
NEXT_PUBLIC_SITE_URL="https://www.deethavorn.com"

# Google Tag Manager Container ID (สำหรับ Production Tracking)
NEXT_PUBLIC_GTM_ID="GTM-M2JQJX4Q"

# คีย์สำหรับเข้ารหัส JWT Admin Session (บังคับความยาวอย่างน้อย 32 ตัวอักษร เช่นสร้างด้วย openssl rand -hex 32)
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters"

# คีย์แยกสำหรับเข้ารหัสค่าความลับในฐานข้อมูลด้วย AES-256-GCM (ทางเลือก — หากไม่ระบุจะแปลงคีย์แยกจาก JWT_SECRET อัตโนมัติ)
SETTINGS_ENCRYPTION_KEY=""

# คีย์ยืนยันตัวตนสำหรับส่ง IndexNow ไปยัง Bing / AI Search (ทางเลือก เช่นสร้างด้วย openssl rand -hex 16)
INDEXNOW_KEY=""

# Google Search Console Service Account JSON และ Site URL (ทางเลือก — สามารถตั้งค่าผ่านหน้าแอดมินโดย Super Admin ได้เช่นกัน)
GSC_SERVICE_ACCOUNT_JSON=""
GSC_SITE_URL=""

# บัญชีผู้ดูแลเริ่มต้น ใช้เฉพาะตอน seed และไม่ควร commit ค่าจริง
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
RESET_ADMIN_PASSWORD="false"
