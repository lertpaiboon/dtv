datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ผู้ติดต่อ / ขอคำปรึกษาผ่านแบบฟอร์มหน้าเว็บ
model ContactLead {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(50)
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(20) // NEW, CONTACTED, CLOSED
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_leads")
}

// คลังความรู้และบทความบัญชี/ภาษี (Knowledge Hub / Blog)
model Article {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  summary     String?  @db.VarChar(500)
  content     String   @db.LongText
  category    String   @db.VarChar(50) // ภาษี, บัญชี, จดทะเบียนธุรกิจ, ทรัพยากรบุคคล
  coverImage  String?  @map("cover_image") @db.VarChar(255)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

// คำถามที่พบบ่อย (FAQs)
model Faq {
  id        Int    @id @default(autoincrement())
  question  String @db.VarChar(255)
  answer    String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  @@map("faqs")
}
