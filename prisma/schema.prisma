datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// 1. ตารางหน้าบ้านเดิม (Public Web Leads & Content)
// ------------------------------------------------------------------------------

// ผู้ติดต่อ / ขอคำปรึกษาผ่านแบบฟอร์มหน้าเว็บ
model ContactLead {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(50)
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(20) // NEW, CONTACTED, CLOSED
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_leads")
}

// ------------------------------------------------------------------------------
// คลังความรู้และบทความบัญชี/ภาษี (Knowledge Hub / E-E-A-T Editorial)
// ------------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Author {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(120)
  slug             String    @unique @db.VarChar(160)
  role             String?   @db.VarChar(160)
  bio              String?   @db.Text
  credentials      String?   @db.Text
  profileImage     String?   @map("profile_image") @db.VarChar(255)
  sameAs           Json?     @map("same_as")
  isActive         Boolean   @default(true) @map("is_active")
  authoredArticles Article[] @relation("ArticleAuthor")
  reviewedArticles Article[] @relation("ArticleReviewer")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("authors")
}

model Article {
  id               Int               @id @default(autoincrement())
  title            String            @db.VarChar(255)
  slug             String            @unique @db.VarChar(255)
  summary          String            @db.VarChar(500)
  contentMarkdown  String            @map("content_markdown") @db.LongText
  category         String            @db.VarChar(80)
  coverImage       String?           @map("cover_image") @db.VarChar(255)
  coverImageAlt    String?           @map("cover_image_alt") @db.VarChar(255)
  quickAnswer      String?           @map("quick_answer") @db.Text
  status           ArticleStatus     @default(DRAFT)
  focusKeyword     String?           @map("focus_keyword") @db.VarChar(120)
  seoScore         Int               @default(0) @map("seo_score")
  isNoIndex        Boolean           @default(false) @map("is_no_index")
  canonicalUrl     String?           @map("canonical_url") @db.VarChar(500)
  ogImage          String?           @map("og_image") @db.VarChar(255)
  authorId         Int?              @map("author_id")
  author           Author?           @relation("ArticleAuthor", fields: [authorId], references: [id])
  reviewerId       Int?              @map("reviewer_id")
  reviewer         Author?           @relation("ArticleReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?         @map("reviewed_at")
  publishedAt      DateTime?         @map("published_at")
  contentUpdatedAt DateTime?         @map("content_updated_at")
  nextReviewAt     DateTime?         @map("next_review_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  faqs             ArticleFaq[]
  citations        ArticleCitation[]
  redirects        ArticleRedirect[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@map("articles")
}

model ArticleFaq {
  id        Int     @id @default(autoincrement())
  articleId Int     @map("article_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question  String  @db.VarChar(255)
  answer    String  @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  @@index([articleId, sortOrder])
  @@map("article_faqs")
}

model ArticleCitation {
  id            Int       @id @default(autoincrement())
  articleId     Int       @map("article_id")
  article       Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title         String    @db.VarChar(255)
  publisher     String?   @db.VarChar(160)
  url           String    @db.VarChar(1000)
  referenceDate DateTime? @map("reference_date") @db.Date
  accessedAt    DateTime? @map("accessed_at") @db.Date
  sortOrder     Int       @default(0) @map("sort_order")

  @@index([articleId, sortOrder])
  @@map("article_citations")
}

model ArticleRedirect {
  id        Int      @id @default(autoincrement())
  fromSlug  String   @unique @map("from_slug") @db.VarChar(255)
  articleId Int      @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([articleId])
  @@map("article_redirects")
}


// คำถามที่พบบ่อย (FAQs)
model Faq {
  id        Int    @id @default(autoincrement())
  question  String @db.VarChar(255)
  answer    String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  @@map("faqs")
}

// ------------------------------------------------------------------------------
// 2. ตารางระบบหลังบ้าน (RBAC & Authentication)
// ------------------------------------------------------------------------------

// บทบาทและสิทธิ์การใช้งาน (RBAC Matrix)
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50) // SUPER_ADMIN, ACCOUNTANT, VIEWER
  description String?  @db.VarChar(255)
  permissions Json     // รายการสิทธิ์ เช่น ["pnd51:view", "pnd51:create", ...]
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ผู้ใช้งานระบบหลังบ้าน
model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique @db.VarChar(150)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(100)
  roleId       Int           @map("role_id")
  role         Role          @relation(fields: [roleId], references: [id])
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  taxPayments  TaxPayment[]
  followUpLogs FollowUpLog[]

  @@map("users")
}

// ------------------------------------------------------------------------------
// 3. ตารางทะเบียนบริษัท และรายชื่อผู้ติดต่อย่อย (Company Directory)
// ------------------------------------------------------------------------------

// รายชื่อบริษัทลูกค้า (Reusable Master)
model Company {
  id           Int              @id @default(autoincrement())
  name         String           @unique @db.VarChar(200) // เช่น บจก.โซเชี่ยว
  taxId        String?          @map("tax_id") @db.VarChar(20) // เลขประจำตัวผู้เสียภาษี 13 หลัก
  email        String?          @db.VarChar(150) // อีเมลกลางของบริษัท
  phone        String?          @db.VarChar(50)
  address      String?          @db.Text // ที่อยู่ออกใบกำกับ/ใบเสร็จ
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  contacts     CompanyContact[] // 1 บริษัทมีหลายผู้ติดต่อ (การเงิน, กรรมการ, บัญชี)
  taxPayments  TaxPayment[]
  followUpLogs FollowUpLog[]

  @@map("companies")
}

// ผู้ติดต่อย่อยในแต่ละบริษัท (การเงิน, บัญชี, กรรมการ)
model CompanyContact {
  id           Int           @id @default(autoincrement())
  companyId    Int           @map("company_id")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(100) // ชื่อผู้ติดต่อ
  roleTitle    String?       @map("role_title") @db.VarChar(100) // เช่น ฝ่ายการเงิน, บัญชี, กรรมการ
  phone        String?       @db.VarChar(50)
  email        String?       @db.VarChar(150)
  lineId       String?       @map("line_id") @db.VarChar(100)
  isPrimary    Boolean       @default(false) @map("is_primary")
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  followUpLogs FollowUpLog[]

  @@map("company_contacts")
}

// ------------------------------------------------------------------------------
// 4. วิธีการชำระเงิน, บันทึกภาษี และประวัติการทวงถาม (Tax Payments & Dunning)
// ------------------------------------------------------------------------------

// วิธีการชำระเงิน (บัตรเครดิตสำนักงาน, โอน, เงินสด)
model PaymentMethod {
  id             Int          @id @default(autoincrement())
  code           String       @unique @db.VarChar(50) // SCB_CARD, BBL_CARD, KBANK_CARD, TRANSFER, CASH
  name           String       @db.VarChar(100) // บัตรเครดิต SCB, บัตรเครดิต BBL, บัตรเครดิต KBANK
  cardLastDigits String?      @map("card_last_digits") @db.VarChar(4) // เช่น 1234
  isActive       Boolean      @default(true) @map("is_active")
  taxPayments    TaxPayment[]

  @@map("payment_methods")
}

// รายการบันทึกการชำระภาษีแทนลูกค้า (ภ.ง.ด.51, ภ.ง.ด.1/3/53, ภ.พ.30)
model TaxPayment {
  id              Int           @id @default(autoincrement())
  companyId       Int           @map("company_id")
  company         Company       @relation(fields: [companyId], references: [id])
  paymentMethodId Int           @map("payment_method_id")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  
  // ประเภทภาษี: PND51, PND50, WHT_PND1, WHT_PND3, WHT_PND53, VAT_PP30
  taxType         String        @map("tax_type") @db.VarChar(30)
  taxYear         String        @map("tax_year") @db.VarChar(10) // เช่น 2569
  taxMonth        String?       @map("tax_month") @db.VarChar(10) // เช่น 09 (สำหรับภาษีรายเดือน)
  paymentDate     DateTime      @map("payment_date") @db.Date // วันที่จ่ายจริง เช่น 2026-09-08
  
  amount          Decimal       @db.Decimal(12, 2) // ยอดเงิน เช่น 74704.00
  referenceNo     String?       @map("reference_no") @db.VarChar(100) // เลขที่สลิป/อ้างอิง
  
  // สถานะการเรียกเก็บเงินคืนจากลูกค้า: UNBILLED, BILLED, PAID
  billingStatus    String        @default("UNBILLED") @map("billing_status") @db.VarChar(20)
  reimbursedAt     DateTime?     @map("reimbursed_at") // วันที่ลูกค้าโอนเงินคืน
  reimbursementRef String?       @map("reimbursement_ref") @db.VarChar(100) // เลขที่อ้างอิงการโอนเงินคืน
  slipUrl          String?       @map("slip_url") @db.VarChar(255) // URL ไฟล์สลิปหลักฐาน
  slipFileName     String?       @map("slip_file_name") @db.VarChar(255) // ชื่อไฟล์ดั้งเดิม
  
  note            String?       @db.Text
  createdById     Int           @map("created_by_id")
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  followUpLogs    FollowUpLog[]

  @@index([taxType, taxYear])
  @@index([companyId])
  @@index([paymentMethodId])
  @@map("tax_payments")
}

// ประวัติการทวงถาม/ติดตามยอดค้างชำระ (Dunning & Collection Activity Log)
model FollowUpLog {
  id           Int             @id @default(autoincrement())
  companyId    Int             @map("company_id")
  company      Company         @relation(fields: [companyId], references: [id])
  contactId    Int?            @map("contact_id") // ระบุผู้ติดต่อย่อยที่คุยด้วย (ถ้ามี)
  contact      CompanyContact? @relation(fields: [contactId], references: [id])
  taxPaymentId Int?            @map("tax_payment_id")
  taxPayment   TaxPayment?     @relation(fields: [taxPaymentId], references: [id])
  
  // ช่องทาง: PHONE (โทรศัพท์), LINE (ไลน์), EMAIL (อีเมล), IN_PERSON (เข้าพบ), OTHER (อื่นๆ)
  channel      String          @db.VarChar(30)
  
  // ผลการติดต่อ: PROMISED (นัดวันชำระ), NO_ANSWER (ไม่รับสาย), REJECTED (ติดปัญหา/ขอเอกสารเพิ่ม), PAID (แจ้งว่าโอนแล้ว)
  result       String          @db.VarChar(50)
  promisedDate DateTime?       @map("promised_date") @db.Date // วันที่ลูกค้านัดโอนชำระ
  notes        String?         @db.Text // บันทึกบทสนทนา
  
  createdById  Int             @map("created_by_id")
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at") // วันที่และเวลาที่บันทึก

  @@index([companyId])
  @@index([contactId])
  @@index([taxPaymentId])
  @@map("follow_up_logs")
}

// ------------------------------------------------------------------------------
// 5. การตั้งค่าระบบ (System Settings & Message Templates)
// ------------------------------------------------------------------------------

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100) // เช่น billing_line_template
  value       String   @db.Text // ค่าคอนฟิก
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ------------------------------------------------------------------------------
// 6. ศูนย์ควบคุม SEO Suite (Rank Math Architecture for Next.js)
// ------------------------------------------------------------------------------

// ตารางบันทึกการส่งคำขอ Instant Indexing (IndexNow API)
model IndexingLog {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(500)
  engine    String   @default("IndexNow") @db.VarChar(50) // IndexNow, Google
  status    String   @db.VarChar(50) // SUCCESS, FAILED
  response  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("indexing_logs")
}

// ตารางบันทึก 404 Errors เพื่อนำมาตรวจจับลิงก์เสียและทำ 301 Redirects
model ErrorLog404 {
  id        Int      @id @default(autoincrement())
  url       String   @unique @db.VarChar(500)
  referrer  String?  @db.VarChar(500)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  hits      Int      @default(1)
  isResolved Boolean @default(false) @map("is_resolved")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hits])
  @@map("error_logs_404")
}

// ตารางจัดการ Custom Redirects (301 Permanent / 302 Temporary)
model CustomRedirect {
  id          Int       @id @default(autoincrement())
  sourcePath  String    @unique @map("source_path") @db.VarChar(500)
  targetPath  String    @map("target_path") @db.VarChar(500)
  statusCode  Int       @default(301) @map("status_code") // 301 or 302
  isActive    Boolean   @default(true) @map("is_active")
  hits        Int       @default(0)
  lastHitAt   DateTime? @map("last_hit_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("custom_redirects")
}

